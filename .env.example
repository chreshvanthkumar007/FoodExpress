# FoodExpress - MySQL Database & Flask App Configuration
# Copy this file to .env and configure your MySQL credentials

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=online_food_delivery

# Flask Application Secret Key
SECRET_KEY=change_this_secret_key_to_a_random_unique_string

# Set to True only if you wish to run a quick demo using SQLite instead of MySQL
USE_SQLITE=False
